#theme = "light:vscode-light,dark:vscode-dark"
theme = "vscode-dark"
#theme = "light:vscode-dark,dark:vscode-dark"
#theme = "Kanagawa Wave"

#adjust-cell-width=
#adjust-cell-height=-1
#adjust-font-baseline=1

font-family = "Victor Mono"
font-size = 13
font-thicken = true
font-thicken-strength = 100


macos-titlebar-proxy-icon = hidden
macos-titlebar-style = hidden

window-padding-x = 8
window-padding-y = 4
window-padding-balance = true
window-padding-color = "extend-always"

#window-colorspace = "display-p3"
#window-title-font-family = "Menlo"

macos-icon = custom-style
macos-icon-screen-color = #000000,#333333
macos-icon-ghost-color = #ffffff

#background-opacity = 0.99


#adjust-underline-position = 2
#adjust-strikethrough-thickness = 0
keybind = shift+enter=text:\x1b\r
